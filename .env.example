# .env.example - Template for PRP Pipeline configuration
# Copy this file to .env and fill in your values
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your API credentials

# =============================================================================
# API AUTHENTICATION
# =============================================================================

# --- PRIMARY (pi + zai default) ---
# Option A: Use pi /login (writes ~/.pi/agent/auth.json, auto-detected by the harness)
#
# Option B: Set ZAI_API_KEY directly
ZAI_API_KEY=your-zai-key-here

# --- OPTIONAL: Anthropic-only credentials (claude-code harness / anthropic/* models) ---
# These are ONLY consulted when the resolved provider is 'anthropic'.
# For the default zai provider, they are ignored.
# ANTHROPIC_AUTH_TOKEN=your-anthropic-token-here
# ANTHROPIC_API_KEY=your-anthropic-key-here

# --- OPTIONAL: Explicit API-key override (highest precedence, any provider) ---
# PRP_API_KEY=your-override-key-here

# =============================================================================
# API ENDPOINT
# =============================================================================

# Canonical provider-neutral endpoint (PRD §9.2.8). Defaults to z.ai for the
# default `zai` provider; leave unset for the anthropic provider.
# WARNING: Do NOT use https://api.anthropic.com (blocked by safeguards)
# PRP_API_BASE_URL=https://api.z.ai/api/anthropic
#
# DEPRECATED legacy alias (still readable, emits a one-time warning; PRD §9.2.8):
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# =============================================================================
# MODEL CONFIGURATION
# ==============================================================================
# Model selection is USER-CONFIGURABLE here, NOT hard-coded in source.
# The pipeline reads these env vars (via getModel()) canonical-first, falling back
# to the deprecated ANTHROPIC_DEFAULT_* aliases; if both are unset it uses the
# sensible defaults baked into config/constants.ts. You SHOULD set them explicitly
# so your chosen models are version-controlled and obvious.
#
# Values are provider-qualified ids as registered in the Pi model registry.
# Registry ids are LOWERCASE. To see what's available, run:
#   pi --list-models zai

# Canonical provider-neutral model tiers (PRD §9.2.8):

# Model for Architect agent (highest quality, complex reasoning)
PRP_MODEL_HIGH=glm-5.2

# Model for Researcher/Coder agents (balanced, default)
PRP_MODEL_BALANCED=glm-5.2

# Model for simple operations (fastest)
PRP_MODEL_FAST=glm-5-turbo

# DEPRECATED legacy aliases (still readable, emit a one-time warning; PRD §9.2.8):
# ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.2
# ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5.2
# ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-5-turbo

# =============================================================================
# REASONING LEVELS (PER-ROLE / PRD §9.2.9)
# =============================================================================
# Per-role extended-thinking ("reasoning") budget. Which MODEL a role runs and how
# hard it REASONS are TWO INDEPENDENT axes (PRD §9.2.3 / §9.2.9): tuning one never
# forces a compromise on the other — you can run a strong model with reasoning off,
# or a fast model with reasoning on. You no longer drop model tier merely to disable
# thinking.
#
# Valid levels (case-insensitive): off, minimal, low, medium, high, xhigh
# (xhigh is the maximum; there is no `max`). See PRD §9.2.9.
#
# Defaults apply when a var is unset/blank; uncomment + set to override.

# Reasoning level for the research/PRP role (default high)
# PRP_REASONING_AGENT=high

# Reasoning level for task decomposition (default high)
# PRP_REASONING_BREAKDOWN_AGENT=high

# Reasoning level for the bug finder (default high)
# PRP_REASONING_BUG_FINDER_AGENT=high

# Reasoning level for validation (default high)
# PRP_REASONING_VALIDATION_AGENT=high

# Reasoning level for implementation/codegen (default OFF — codegen runs a full
# PRP contract; reasoning off is faster, cheaper, and decouples from model tier)
# PRP_REASONING_IMPL_AGENT=off

# Semantics: an empty/whitespace value falls back to the role default (never
# forwarded). An invalid value (e.g. PRP_REASONING_AGENT=ultra) is a HARD
# startup error (exit 1, naming the var, value, and accepted levels; PRD §9.2.7).
# The same vars are also configurable via .hack [reasoning] keys (§9.7.5); shell
# env / .env override .hack per §9.2.1.

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Request timeout in milliseconds (default: 60000)
# API_TIMEOUT_MS=300000

# =============================================================================
# DISTRIBUTED / MULTI-FILE PRDs
# =============================================================================
#
# See PRD §2.3. An `@path/to/file.md` token is an include directive replaced inline by
# the referenced file's contents (resolved project-root-relative to the entry PRD's dir).
#
# Max recursion depth for include expansion (default: 10).
# PRD_INCLUDE_MAX_DEPTH=10
#
# When set, resolved output emits <!-- @include: path --> markers; a stale .md include
# (path that fails to resolve) emits a stderr warning.
# PRD_INCLUDE_MARKERS=

# =============================================================================
# CONCURRENCY CONFIGURATION
# =============================================================================

# Max concurrent research tasks for parallel PRP generation (1-10, default: 3)
# Higher values = faster PRP generation but more API usage
# Lower values = slower but respects rate limits
# RESEARCH_QUEUE_CONCURRENCY=3

# =============================================================================
# RESEARCH CONFIGURATION (PARALLEL PRP RESEARCH)
# =============================================================================

# Enable background (parallel) PRP research (default: false). See PRD §4.2.
# PARALLEL_RESEARCH=true

# How many items ahead the supervisor prefetches as a chain (default: 2). See PRD §4.2.
# RESEARCH_DEPTH=2

# Deadline in seconds for background research before synchronous fallback (default: 1800 = 30min). See PRD §4.2.
# RESEARCH_TIMEOUT=1800

# --- Smart Commit Resilience (PRD §5.1) ---
# Values in milliseconds. COMMIT_RETRY_MAX is the total attempt count (initial + retries).
# COMMIT_RETRY_MAX=5
# COMMIT_RETRY_DELAY=10000
# COMMIT_RETRY_DELAY_CAP=120000

# --- Commit Message Style (PRD §5.1) ---
# PRP_COMMIT_STYLE governs the descriptive-message STYLE, orthogonal to PRP_COMMIT_FORMAT's
# position prefix. auto (default) learns from the last N commits; plain/conventional/gitmoji
# are explicit contracts. See PRD §5.1, §9.2.2.
# PRP_COMMIT_STYLE=auto
# How many recent commits `auto` sends as style examples (default 5; 0 disables learning).
# PRP_COMMIT_STYLE_EXAMPLES=5

# =============================================================================
# VALIDATION CONFIGURATION (OPTIONAL)
# =============================================================================

# Reasoning-tier agent that generates and runs validate.sh (default: pizr).
# Overrides the generic agent for the validation call only. See PRD §4.4, §9.2.2.
# VALIDATION_AGENT=pizr

# Watchdog budget in seconds for the validation call (default: 7200 = 2h — validation
# legitimately runs full test suites). Overrides the generic agent timeout for this call
# only. See PRD §4.4, §9.2.2.
# VALIDATION_TIMEOUT=7200

# =============================================================================
# BUG HUNT CONFIGURATION (OPTIONAL)
# =============================================================================

# Reasoning-tier agent used for creative bug discovery (default: pizr). The bug-finder
# runs as the reasoning persona at the maximum reasoning budget (xhigh). See PRD §4.4,
# §9.2.2, §9.2.3.
# BUG_FINDER_AGENT=pizr

# =============================================================================
# SECURITY NOTES
# =============================================================================

# NEVER commit this file to version control with actual API keys
# .env is listed in .gitignore
# Only commit .env.example as a template
